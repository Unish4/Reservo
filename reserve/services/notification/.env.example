NODE_ENV=development
PORT=4004
LOG_LEVEL=debug
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/reserve?retryWrites=true&w=majority

# RabbitMQ (local docker: amqp://guest:guest@localhost:5672)
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=reserve.events
RABBITMQ_PREFETCH=10

# "console" just logs the email (no account needed). "smtp" sends for real.
EMAIL_PROVIDER=console
EMAIL_FROM="Reserve <no-reply@reserve.local>"

# Only required when EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# A "pending" notification older than this is assumed crashed and may be retaken
PENDING_STALE_MS=120000
